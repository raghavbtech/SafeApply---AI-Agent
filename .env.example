# SafeApply - Azure Configuration Template
# Copy this file to .env and fill in your values from Azure Portal
# NEVER commit your real .env file!

# Azure AI Foundry / Azure OpenAI
# Deploy a model like gpt-4o-mini in Azure AI Foundry / Azure OpenAI Studio
AZURE_OPENAI_ENDPOINT=https://your-foundry-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Azure AI Search (F0 Free Tier recommended)
SEARCH_ENDPOINT=https://your-search-service.search.windows.net
SEARCH_API_KEY=your_search_admin_api_key_here
SEARCH_INDEX_NAME=safeapply-scam-patterns

# Azure AI Language Service (F0 Free Tier recommended)
LANGUAGE_ENDPOINT=https://your-language-service.cognitiveservices.azure.com/
LANGUAGE_API_KEY=your_language_api_key_here
