# SafeApply Environment Configuration Template
# Copy this file to .env and configure for your environment.
# NEVER commit real credentials or .env to version control.

# =========================================================
# APPLICATION & AUTHENTICATION
# =========================================================
SAFEAPPLY_ENV=development
# SAFEAPPLY_USER_ID is deprecated and never used as a visitor identity.
SAFEAPPLY_JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
SAFEAPPLY_ACCESS_TOKEN_EXPIRE_MINUTES=1440
SAFEAPPLY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# =========================================================
# AZURE COSMOS DB PERSISTENCE (Optional - local JSON fallback if blank)
# =========================================================
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=safeapply
COSMOS_EMAIL_CONTAINER=emails
COSMOS_AUDIT_CONTAINER=audit
SAFEAPPLY_LOCAL_DB=.safeapply_local_db.json

# =========================================================
# GENAI SYNTHESIS (Azure AI Foundry / Azure OpenAI / GitHub Models)
# =========================================================
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
GITHUB_TOKEN=

# =========================================================
# AZURE AI SEARCH & LANGUAGE SERVICES (Optional - local heuristics fallback)
# =========================================================
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=scam-patterns
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=

# =========================================================
# MAILBOX INTEGRATION (IMAP & SMTP)
# =========================================================
MAIL_PROVIDER=Gmail
MAIL_USERNAME=
MAIL_APP_PASSWORD=
MAIL_IMAP_SERVER=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_SMTP_SERVER=smtp.gmail.com

# =========================================================
# SAFETY POLICY & AUTOMATION CONTROLS
# =========================================================
# Production safety defaults: keep false until reviewed user opt-in
AUTO_QUARANTINE_ENABLED=false
AUTO_QUARANTINE_THRESHOLD=65
AUTO_APPLY_ENABLED=false
AUTO_APPLY_MAX_RISK_SCORE=45
ENABLE_REAL_SMTP_DISPATCH=false
SAFEAPPLY_POLL_INTERVAL=30
SAFEAPPLY_SYNC_FETCH_COUNT=20
